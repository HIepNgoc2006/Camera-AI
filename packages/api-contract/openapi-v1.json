  "components": {
    "securitySchemes": {
      "BearerAuth": {"type":"http","scheme":"bearer","bearerFormat":"JWT","description":"Gateway-validated bearer session. Authorization remains object scoped."},
      "BearerMfaAuth": {"type":"http","scheme":"bearer","bearerFormat":"JWT","description":"Gateway-validated bearer session with a current MFA assertion.","x-mfa-required":true}
    },
    "parameters": {
      "XRequestId": {"name":"X-Request-ID","in":"header","required":false,"schema":{"type":"string","pattern":"^req_[A-Za-z0-9_-]{8,120}$"},"description":"Optional caller correlation value; invalid values are replaced, never reflected."},
      "IdempotencyKey": {"name":"Idempotency-Key","in":"header","required":true,"schema":{"type":"string","minLength":16,"maxLength":128,"pattern":"^[A-Za-z0-9._:-]+$"}},
      "Cursor": {"name":"cursor","in":"query","required":false,"schema":{"type":"string","minLength":16,"maxLength":512},"description":"Opaque server-issued cursor."},
      "Limit": {"name":"limit","in":"query","required":false,"schema":{"type":"integer","minimum":1,"maximum":200,"default":50}},
      "SchoolFilter": {"name":"school_id","in":"query","required":false,"schema":{"type":"string","format":"uuid"},"description":"Narrowing filter only; it never expands authorization scope."},
      "ClassFilter": {"name":"class_id","in":"query","required":false,"schema":{"type":"string","format":"uuid"},"description":"Narrowing filter only; it never expands authorization scope."},
      "SchoolId": {"name":"school_id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}},
      "ProfileId": {"name":"profile_id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}},
      "RecordId": {"name":"record_id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}},
      "CaseId": {"name":"case_id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}},
      "EvidenceId": {"name":"evidence_id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}},
      "ConsentId": {"name":"consent_id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}},
      "AssignmentId": {"name":"assignment_id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}},
      "ReportId": {"name":"report_id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}},
      "CameraId": {"name":"camera_id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}},
      "NotificationId": {"name":"notification_id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}
    },
    "headers": {
      "XRequestId": {"description":"Server-validated request identifier.","schema":{"type":"string","pattern":"^req_[A-Za-z0-9_-]{8,120}$"}},
      "RetryAfter": {"description":"Seconds until a retry is allowed.","required":true,"schema":{"type":"integer","minimum":1}}
    },
    "schemas": {
      "ErrorResponse": {
        "type":"object",
        "additionalProperties":false,
        "required":["error_code","message","request_id"],
        "properties":{
          "error_code":{"type":"string","pattern":"^[A-Z][A-Z0-9_]{2,95}$"},
          "message":{"type":"string","minLength":1,"maxLength":160},
          "request_id":{"type":"string","pattern":"^req_[A-Za-z0-9_-]{8,120}$"}
        }
      },
      "SuccessEnvelope": {
        "type":"object",
        "additionalProperties":false,
        "required":["resource_id","request_id"],
        "properties":{
          "resource_id":{"type":"string","format":"uuid"},
          "request_id":{"type":"string","pattern":"^req_[A-Za-z0-9_-]{8,120}$"}
        }
      },
      "AcceptedEnvelope": {
        "type":"object",
        "additionalProperties":false,
        "required":["operation_id","request_id"],
        "properties":{
          "operation_id":{"type":"string","format":"uuid"},
          "request_id":{"type":"string","pattern":"^req_[A-Za-z0-9_-]{8,120}$"}
        }
      },
      "OpaqueResourceSummary": {
        "type":"object",
        "additionalProperties":false,
        "required":["resource_id","resource_type","updated_at"],
        "properties":{
          "resource_id":{"type":"string","format":"uuid"},
          "resource_type":{"type":"string","pattern":"^[a-z][a-z0-9_]{1,63}$"},
          "updated_at":{"type":"string","format":"date-time"}
        }
      },
      "CursorPage": {
        "type":"object",
        "additionalProperties":false,
        "required":["items","next_cursor","request_id"],
        "properties":{
          "items":{"type":"array","maxItems":200,"items":{"$ref":"#/components/schemas/OpaqueResourceSummary"}},
          "next_cursor":{"type":["string","null"],"minLength":16,"maxLength":512},
          "request_id":{"type":"string","pattern":"^req_[A-Za-z0-9_-]{8,120}$"}
        }
      }
    },
    "responses": {
      "Success": {"description":"Authorized response.","headers":{"X-Request-ID":{"$ref":"#/components/headers/XRequestId"}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/SuccessEnvelope"},"example":{"resource_id":"00000000-0000-4000-8000-000000000001","request_id":"req_synthetic_0001"}}}},
      "Accepted": {"description":"Authorized command accepted.","headers":{"X-Request-ID":{"$ref":"#/components/headers/XRequestId"}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/AcceptedEnvelope"},"example":{"operation_id":"00000000-0000-4000-8000-000000000002","request_id":"req_synthetic_0001"}}}},
      "CursorPage": {"description":"Authorized cursor page.","headers":{"X-Request-ID":{"$ref":"#/components/headers/XRequestId"}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CursorPage"},"example":{"items":[],"next_cursor":null,"request_id":"req_synthetic_0001"}}}},
      "BadRequest": {"description":"Invalid request.","headers":{"X-Request-ID":{"$ref":"#/components/headers/XRequestId"}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"},"example":{"error_code":"BAD_REQUEST","message":"The request is invalid.","request_id":"req_synthetic_0001"}}}},
      "Unauthorized": {"description":"Authentication required.","headers":{"X-Request-ID":{"$ref":"#/components/headers/XRequestId"}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"},"example":{"error_code":"AUTHENTICATION_REQUIRED","message":"Authentication is required.","request_id":"req_synthetic_0001"}}}},
      "ProtectedDenied": {"description":"Protected resource unavailable; missing and unauthorized are intentionally indistinguishable.","headers":{"X-Request-ID":{"$ref":"#/components/headers/XRequestId"}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"},"example":{"error_code":"AUTHZ_DENIED","message":"The requested resource is unavailable.","request_id":"req_synthetic_0001"}}}},
      "Conflict": {"description":"Request conflict.","headers":{"X-Request-ID":{"$ref":"#/components/headers/XRequestId"}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"},"example":{"error_code":"IDEMPOTENCY_CONFLICT","message":"The idempotency key conflicts with an earlier request.","request_id":"req_synthetic_0001"}}}},
      "ValidationFailed": {"description":"Validation failed.","headers":{"X-Request-ID":{"$ref":"#/components/headers/XRequestId"}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"},"example":{"error_code":"VALIDATION_FAILED","message":"The request failed validation.","request_id":"req_synthetic_0001"}}}},
      "RateLimited": {"description":"Rate limit exceeded.","headers":{"X-Request-ID":{"$ref":"#/components/headers/XRequestId"},"Retry-After":{"$ref":"#/components/headers/RetryAfter"}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"},"example":{"error_code":"RATE_LIMITED","message":"Too many requests.","request_id":"req_synthetic_0001"}}}},
      "Unavailable": {"description":"A required fail-closed dependency is unavailable.","headers":{"X-Request-ID":{"$ref":"#/components/headers/XRequestId"}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"},"example":{"error_code":"SERVICE_UNAVAILABLE","message":"The service is temporarily unavailable.","request_id":"req_synthetic_0001"}}}}
    }
  }
