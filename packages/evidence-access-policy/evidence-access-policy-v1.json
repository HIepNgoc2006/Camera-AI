  "evidence_states": {
    "recognized": [
      "pending_upload",
      "quarantined",
      "available",
      "delete_pending",
      "deleted",
      "missing"
    ],
    "readable": [
      "available"
    ]
  },
  "retention": {
    "required_status": "active",
    "expired_denied_before_physical_disposal": true,
    "source_hold_does_not_extend_export_artifact": true
  },
  "consent": {
    "recognized_statuses": [
      "allowed",
      "blocked",
      "not_required"
    ],
    "required_result": "allowed",
    "missing_or_ambiguous_decision": "deny"
  },
  "legal_hold": {
    "recognized_statuses": [
      "none",
      "active",
      "released"
    ],
    "active_blocks_disposal_only": true,
    "active_does_not_grant_access": true,
    "active_does_not_extend_expired_access": true,
    "missing_or_ambiguous_decision": "deny"
  },
  "signed_get": {
    "profiles": {
      "standard_view": {
        "default_ttl_seconds": 60,
        "minimum_ttl_seconds": 1,
        "hard_max_ttl_seconds": 300
      },
      "export_delivery": {
        "default_ttl_seconds": 60,
        "minimum_ttl_seconds": 1,
        "hard_max_ttl_seconds": 120
      }
    },
    "method": "GET",
    "persistence_allowed": false,
    "logging_allowed": false,
    "notification_delivery_allowed": false,
    "client_storage_allowed": false,
    "response_headers": {
      "cache_control": "private, no-store",
      "x_content_type_options": "nosniff",
      "content_disposition": "safe_allowlisted"
    }
  },
  "export": {
    "artifact_default_ttl_seconds": 604800,
    "artifact_hard_max_ttl_seconds": 604800,
    "source_authorization_required_at_request": true,
    "source_authorization_required_at_delivery": true,
    "ordinary_view_or_download_does_not_imply_export": true,
    "distinct_artifact_hold_required": true,
    "reason_code_allowlist": [
      "ATTENDANCE_AUDIT",
      "TIMEKEEPING_AUDIT",
      "VIOLATION_REVIEW",
      "SECURITY_INVESTIGATION",
      "LEGAL_REQUEST",
      "DATA_SUBJECT_REQUEST",
      "MANAGEMENT_REPORT"
    ],
    "recipient_control_allowlist": [
      "authenticated_requester",
      "approved_internal_recipient",
      "approved_external_recipient_with_expiry"
    ]
  },
  "audit": {
