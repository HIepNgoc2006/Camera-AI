    "allowed_visibility_states": [
      "unknown",
      "partial_visibility",
      "clear"
    ],
    "allowed_temporal_evidence": [
      "none",
      "single_frame",
      "multi_frame"
    ],
    "allowed_review_outcomes": [
      "not_reviewed",
      "confirmed",
      "rejected",
      "needs_more_evidence"
    ],
    "reviewer_requirements": [
