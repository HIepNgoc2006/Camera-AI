      ],
      "shadow": [
        "review_required",
        "accepted",
        "disabled"
      ],
      "review_required": [
        "shadow",
        "accepted",
        "disabled"
      ],
      "accepted": [
        "shadow",
        "production",
        "disabled"
      ],
      "production": [
        "shadow",
        "disabled"
      ]
