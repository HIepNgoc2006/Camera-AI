  "public_errors": {
    "concealed": "NOTIFICATION_NOT_FOUND",
    "not_available": "NOTIFICATION_NOT_AVAILABLE",
    "invalid": "NOTIFICATION_REQUEST_INVALID",
    "dependency_unavailable": "NOTIFICATION_DELIVERY_UNAVAILABLE"
