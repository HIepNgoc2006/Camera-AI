  "service_actor_matrix": {
    "notification_service": {
      "trusted_identity_required": true,
      "permission_code": "service.notification.dispatch",
      "allowed_operations": [
        "dispatch",
        "retry",
        "dead_letter",
        "open",
        "cancel"
      ]
    },
    "source_business_service": {
      "trusted_identity_required": true,
      "permission_code": "service.notification.request",
      "delegation_required": true
    },
    "provider_adapter": {
      "trusted_identity_required": true,
      "permission_code": "service.notification.provider_deliver",
      "required_channels": [
        "push",
        "email"
      ]
    }
  },
  "authorization": {
    "dispatch_checks": [
      "exact_active_policy_version_and_named_approvals",
      "trusted_notification_and_source_service_identity",
      "approved_source_delegation",
      "active_verified_recipient_identity",
      "tenant_and_school_scope",
      "current_object_relationship",
      "exact_current_permission",
      "approved_purpose",
      "authoritative_consent_decision",
      "content_class_channel_and_template_allowlist",
      "source_notification_eligibility_and_state",
      "source_and_notification_expiry",
      "current_endpoint_owner_verification_and_preference",
      "deduplication_and_cancellation_state"
    ],
    "open_checks": [
      "authenticated_current_recipient",
      "notification_not_expired_or_cancelled",
      "fresh_tenant_school_object_relationship",
      "fresh_permission_purpose_and_consent",
      "fresh_source_state_and_retention",
      "resource_service_authorization"
    ],
    "notification_payload_is_never_authority": true,
    "wrong_recipient_scope_and_missing_resource_share_public_error": true
  },
  "endpoint_protection": {
    "device_token_storage": "ENCV1_ciphertext",
    "device_token_exact_lookup": "LOOKUP-V1/device-token-v1",
    "email_endpoint_storage": "ENCV1_ciphertext",
    "plaintext_boundary": "provider_dispatch_only",
    "required_status": "active_verified_owned",
    "revoked_inactive_reassigned_or_ambiguous_behavior": "deny_and_cancel_pending",
    "invalid_provider_endpoint_behavior": "revoke_without_logging_endpoint_value",
    "forbidden_destinations": [
      "audit",
      "log",
      "trace",
      "queue",
      "dead_letter",
      "notification_content",
      "response",
      "support_export"
    ]
  },
  "expiry_retry_and_dead_letter": {
    "notification_expires_at_required": true,
    "source_expires_at_required": true,
    "notification_must_not_outlive_source_or_purpose": true,
    "retry_profile_requires_named_approved_limits": true,
    "missing_retry_limit_behavior": "deny",
    "retry_must_reauthorize_before_each_attempt": true,
    "retry_must_finish_before_notification_and_source_expiry": true,
    "dead_letter_payload_allowed_fields": [
      "opaque_notification_ref",
      "opaque_recipient_ref",
      "opaque_resource_ref",
      "channel",
      "template_version",
      "policy_version",
      "purpose_code",
      "attempt_count",
      "next_attempt_at",
      "expires_at",
      "correlation_id",
      "stable_failure_category"
    ],
    "dead_letter_never_extends_retention_or_authority": true,
    "deduplication_behavior": "suppress_duplicate_without_duplicate_content_or_audit_payload",
    "cancellation_triggers": [
      "consent_withdrawn",
      "permission_revoked",
      "relationship_revoked",
      "recipient_deactivated",
      "endpoint_revoked",
      "source_rejected",
      "source_expired",
      "purpose_ended",
      "policy_superseded"
    ]
  },
