# Safe local-development placeholders only. Never put real credentials here.
APP_ENV=development
SERVICE_NAME=camera-ai-platform
LOG_LEVEL=INFO

# Local infrastructure
DATABASE_URL=postgresql+psycopg://camera_ai_app:replace_with_local_password@localhost:5432/camera_ai
REDIS_URL=redis://localhost:6379/0
RABBITMQ_URL=amqp://camera_ai_app:replace_with_local_password@localhost:5672/
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=evidence-local-private
S3_ACCESS_KEY=replace_with_local_access_key
S3_SECRET_KEY=replace_with_local_secret_key

# Security-first defaults
BIOMETRIC_PROCESSING_ENABLED=false
ANSVIS_DEBUG_ENABLED=false
EVIDENCE_BUCKET_PUBLIC=false
SIGNED_URL_TTL_SECONDS=300
LOG_SENSITIVE_PAYLOADS=false

# ANSVIS integration placeholders; use a secret manager outside local development.
ANSVIS_WEBHOOK_AUTH_MODE=hmac
ANSVIS_WEBHOOK_SECRET=replace_with_local_only_secret
