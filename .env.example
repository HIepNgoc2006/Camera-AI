# Safe local-development placeholders only. Never put real credentials here.
APP_ENV=development
SERVICE_NAME=camera-ai-platform
LOG_LEVEL=INFO

# Local infrastructure. Keep the password as a placeholder in Git.
DATABASE_URI=postgresql+psycopg://codex_mcp:replace_with_local_password@localhost:5432/Camera_AI_test
TEST_DATABASE_URI=postgresql+psycopg://codex_mcp:replace_with_local_test_password@localhost:55432/Camera_AI_test
AUDIT_DATABASE_URI=postgresql+psycopg://audit_service:replace_with_local_audit_password@localhost:55432/Camera_AI_audit_test
CONSENT_DATABASE_URI=postgresql+psycopg://consent_service:replace_with_local_consent_password@localhost:55434/Camera_AI_consent_test
CAMERA_DATABASE_URI=postgresql+psycopg://camera_registry_service:replace_with_local_camera_password@localhost:55435/Camera_AI_camera_test
POSTGRES_TEST_DB=Camera_AI_test
POSTGRES_TEST_USER=codex_mcp
POSTGRES_TEST_PASSWORD=replace_with_local_test_password
POSTGRES_TEST_PORT=55432
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379
RABBITMQ_URL=amqp://camera_ai_app:replace_with_local_password@localhost:5672/
RABBITMQ_USER=camera_ai_app
RABBITMQ_PASSWORD=replace_with_local_password
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
EVENT_BROKER_URI=amqp://camera_ai_app:replace_with_local_password@localhost:5672/
WORKER_BATCH_SIZE=50
WORKER_IDLE_SLEEP_SECONDS=1
WORKER_BROKER_RETRY_SECONDS=5
METRICS_PORT=9464
WORKER_METRICS_PORT=9465
WORKER_SNAPSHOT_INTERVAL_SECONDS=60
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=evidence-local-private
S3_ACCESS_KEY=replace_with_local_access_key
S3_SECRET_KEY=replace_with_local_secret_key
MINIO_ROOT_USER=replace_with_local_access_key
MINIO_ROOT_PASSWORD=replace_with_local_secret_key
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Security-first defaults
BIOMETRIC_PROCESSING_ENABLED=false
ANSVIS_DEBUG_ENABLED=false
EVIDENCE_BUCKET_PUBLIC=false
SIGNED_URL_TTL_SECONDS=300
LOG_SENSITIVE_PAYLOADS=false

# ANSVIS integration placeholders; use a secret manager outside local development.
ANSVIS_WEBHOOK_AUTH_MODE=hmac
ANSVIS_WEBHOOK_SECRET=replace_with_local_only_secret
